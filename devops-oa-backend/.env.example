# Admin password for creating assessment links (required)
ADMIN_PASSWORD=your-admin-password-here

# Judge0 or Piston API configuration
CODE_EXEC_API_URL=https://judge0-ce.p.rapidapi.com
CODE_EXEC_API_KEY=your-rapidapi-key-here

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://recruit.otcr-consulting.com

# Database URL (SQLite by default)
DATABASE_URL=sqlite:///./devops_oa.db

# Base URL for generated assessment links
FRONTEND_BASE_URL=https://recruit.otcr-consulting.com/#/tech/assessment
