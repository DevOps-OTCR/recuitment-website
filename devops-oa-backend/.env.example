# Admin password for creating assessment links (required)
ADMIN_PASSWORD=your-admin-password-here

# Judge0 or Piston API configuration
CODE_EXEC_API_URL=https://judge0-ce.p.rapidapi.com
CODE_EXEC_API_KEY=your-rapidapi-key-here

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://recruit.otcr-consulting.com

# Database: Supabase Postgres. Required in production.
# Use Transaction pooler on Render (Supabase Dashboard → Connect → Connection pooling → Transaction).
# Supabase pooler does NOT permit PREPARE; the app disables prepared statements when using pooler URL.
# Format: postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.imauccpkchggjzasgsjj:YOUR_DB_PASSWORD@aws-0-us-west-2.pooler.supabase.com:6543/postgres

# Supabase Storage (required when using Supabase Postgres). Service Role key – Project Settings → API.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_KEY=your-service-role-key-here

# Base URL for generated assessment links
FRONTEND_BASE_URL=https://recruit.otcr-consulting.com/#/tech/assessment
