# DevOps OA Backend API URL
# Local: http://localhost:8000
# Production (US): https://recuitment-usa.onrender.com
VITE_OA_API_URL=http://localhost:8000

# Microsoft Entra ID / MSAL (frontend)
# For HashRouter deployments, the redirect URI is usually the sign-in route with a hash fragment.
NEXT_PUBLIC_MSAL_CLIENT_ID=your-entra-app-client-id
NEXT_PUBLIC_MSAL_AUTHORITY=https://login.microsoftonline.com/your-tenant-id
NEXT_PUBLIC_MSAL_REDIRECT_URI=http://localhost:8080/#/sign-in
